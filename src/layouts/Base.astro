---
import '../styles/fonts.css';
import '../styles/global.css';
import { TIME_BOOT_SCRIPT } from '../lib/time';

interface Props {
  title?: string;
  description?: string;
  /** "cover" = over the sea (home); "paper" = magazine pages. */
  surface?: 'cover' | 'paper' | 'tide' | 'deep';
}
const { title, description = '海边周刊 · The Seaside Weekly —— Shane 的个人刊物，每周一期。', surface = 'paper' } = Astro.props;
const fullTitle = title ? `${title} · 海边周刊` : '海边周刊 · The Seaside Weekly';
---

<!doctype html>
<html lang="zh-CN" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14202b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/oppo-sans-site.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistSerifVF.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={TIME_BOOT_SCRIPT} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <slot />
  </body>
</html>
