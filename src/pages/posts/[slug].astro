---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, shortDate, isoDate, minutesOf, vtTitle, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
---
<Base title={post.data.title}>
  <SiteHeader current="posts" />
  <main id="main" class="page article">
    <h1 class="art-title" style={`view-transition-name:${vtTitle(post)}`}>{post.data.title}</h1>
    <p class="art-meta"><time datetime={isoDate(post.data.date)}>{shortDate(post.data.date)}</time> · {minutesOf(post)}min</p>
    {toc.length > 1 && (
      <>
        <nav class="toc toc-side" aria-label="目录">
          <Icon name="toc" size={18} />
          <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
        <details class="toc toc-inline">
          <summary aria-label="目录"><Icon name="toc" size={18} /></summary>
          <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      </>
    )}
    <div class="prose"><Content /></div>
  </main>
  <SiteFooter back="/posts/" />
</Base>
