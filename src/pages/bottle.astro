---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Bottle from '../components/Bottle.tsx';
---

<Base title="漂流瓶" surface="deep">
  <SiteHeader current="bottle" tone="cover" />
  <main id="main" class="bottle-page">
    <header class="bp-head">
      <p class="bp-kicker">Message in a Bottle</p>
      <h1>漂流瓶</h1>
      <p class="bp-lede">这本周刊没有评论区，只有一片海。写一句话扔进去；或者捞一只，看看上一个来到海边的人说了什么。</p>
    </header>
    <Bottle client:load />
    <div class="bp-waves" aria-hidden="true"><i></i><i></i><i></i></div>
  </main>
  <SiteFooter />
</Base>
