---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getIssues, volLabel, fmtDate, vtCover, vtTitle } from '../lib/issues';

const issues = await getIssues();
const n = issues.length;
const tilt = [-2.4, 1.8, -1.2, 2.6, -2, 1.1, -1.6];
---

<Base title="潮汐归档" surface="tide">
  <SiteHeader current="archive" />
  <main id="main" class="tide">
    <header class="tide-head">
      <p class="tide-kicker">Tide Archive</p>
      <h1>潮汐归档</h1>
      <p class="tide-lede">往下滚，就是往回翻旧刊。越早的刊物，越像被潮水冲上岸、晒褪了色的旧杂志。</p>
    </header>

    <div class="tide-gauge" aria-hidden="true">
      <span class="tg-top">满潮<br />新</span>
      <span class="tg-bar"><i></i></span>
      <span class="tg-bottom">退潮<br />旧</span>
    </div>

    <ol class="tide-list">
      {issues.map((i, idx) => (
        <li class="tide-item" style={`--age:${idx / Math.max(1, n - 1)};--tilt:${tilt[idx % tilt.length]}deg`}>
          <a href={`/issues/${i.id}/`} class="tide-card">
            <span class="tide-img">
              <Image src={i.data.cover} alt={i.data.coverAlt} widths={[480, 800]} sizes="(max-width: 720px) 80vw, 380px" style={`view-transition-name:${vtCover(i)}`} />
            </span>
            <span class="tide-text">
              <span class="tide-vol">{volLabel(i.data.vol)}</span>
              <span class="tide-title" style={`view-transition-name:${vtTitle(i)}`}>{i.data.title}</span>
              <span class="tide-dek">{i.data.subtitle}</span>
              <span class="tide-meta">{i.data.section} · {fmtDate(i.data.date)}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <p class="tide-end">再往前，就是还没开始写的那片海了。</p>
  </main>
  <SiteFooter />
</Base>
