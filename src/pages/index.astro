---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Ocean from '../components/Ocean.tsx';
import Icon from '../components/Icon.astro';
import PostItem from '../components/PostItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Moment from '../components/Moment.astro';
import { getPosts } from '../lib/posts';
import { projectGroups } from '../data/projects';
import { moments } from '../data/life';

const posts = (await getPosts()).slice(0, 5);
const projects = projectGroups.flatMap((g) => g.items).slice(0, 3);
---

<Base>
  <div class="sea" aria-hidden="true">
    <div class="sea-poster"></div>
    <Ocean client:only="react" />
  </div>
  <SiteHeader />
  <main id="main" class="page home">
    <h1 class="home-name">Shane</h1>
    <div class="home-intro">
      <p>Hey! I'm TreeTreeDi.</p>
      <p>Welcome to my personal website.</p>
      <p class="home-links"><a href="https://github.com/treetreedi" rel="me"><Icon name="github" size={16} /> GitHub</a></p>
    </div>

    <section class="home-block" aria-labelledby="h-posts">
      <h2 id="h-posts" class="block-head"><a href="/posts/">文章 <Icon name="arrow" size={14} /></a></h2>
      <ul class="post-list">{posts.map((p) => <PostItem post={p} />)}</ul>
    </section>

    <section class="home-block" aria-labelledby="h-projects">
      <h2 id="h-projects" class="block-head"><a href="/projects/">作品 <Icon name="arrow" size={14} /></a></h2>
      <div class="project-grid is-compact">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>

    <section class="home-block" aria-labelledby="h-life">
      <h2 id="h-life" class="block-head"><a href="/life/">生活 <Icon name="arrow" size={14} /></a></h2>
      <ul class="moments is-strip">{moments.slice(0, 4).map((m, i) => <Moment m={m} i={i} sizes="(max-width: 720px) 25vw, 160px" />)}</ul>
    </section>
  </main>
  <SiteFooter />
</Base>
