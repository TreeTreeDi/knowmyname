---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project: p } = Astro.props;
const external = /^https?:/.test(p.href);
---
<a class="project" href={p.href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <span class="pj-tile"><Icon name={p.icon} size={26} /></span>
  <span class="pj-text">
    <span class="pj-name">{p.name}</span>
    <span class="pj-desc">{p.desc}</span>
  </span>
</a>
